
---
const projects = [
  {
    name: "CAD Clinical Decision Support System",
    category: "FINAL YEAR PROJECT",
    description:
      "A web-based clinical decision support prototype integrating machine learning to support coronary artery disease risk assessment.",
    technologies: ["Python", "Flask", "MySQL", "Random Forest"],
    status: "In Development",
  },
  {
    name: "E-commerce Data Engineering Pipeline",
    category: "PERSONAL PROJECT",
    description:
      "An end-to-end data pipeline focused on data quality, reliability, failure detection and recovery.",
    technologies: ["Python", "SQL", "Data Engineering"],
    status: "Planned",
  },
];

const skills = [
  "Python",
  "SQL",
  "Java",
  "Flask",
  "MySQL",
  "Pandas",
  "Scikit-learn",
  "Git",
  "GitHub",
  "HTML",
  "CSS",
  "JavaScript",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Portfolio of Zafril Ihsan, Computer Science student interested in Data Engineering, machine learning and software development."
    />
    <meta name="theme-color" content="#17191F" />
    <title>Zafril Ihsan | Portfolio</title>
  </head>

  <body>
    <!-- Navigation -->
    <header>
      <nav>
        <a class="logo" href="/">ZAFRIL<span>.</span></a>

        <div class="nav-links">
          <a href="#about">About</a>
          <a href="#projects">Projects</a>
          <a href="#skills">Skills</a>
          <a href="#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <!-- Hero Section -->
      <section class="hero">
        <p class="eyebrow">COMPUTER SCIENCE STUDENT · MALAYSIA</p>

        <h1>
          Hi, I'm <span>Zafril Ihsan.</span>
        </h1>

        <h2>Building solutions through data and technology.</h2>

        <p class="intro">
          I am a Computer Science student interested in Data Engineering,
          machine learning and software development. I enjoy building
          practical solutions and exploring how technology works.
        </p>

        <div class="actions">
          <a class="primary-button" href="#projects">
            View My Projects
          </a>

          <a class="secondary-button" href="#contact">
            Get in Touch
          </a>
        </div>

        <div class="hero-bottom">
          <span>DATA ENGINEERING</span>
          <span>SOFTWARE DEVELOPMENT</span>
          <span>MACHINE LEARNING</span>
        </div>
      </section>

      <!-- About Section -->
      <section id="about">
        <p class="eyebrow">01 / ABOUT</p>

        <h2>About Me</h2>

        <p class="section-description">
          I am pursuing a Bachelor's Degree in Computer Science
          (Bioinformatics) at Universiti Teknologi Malaysia (UTM).
          My interests include data engineering, data analytics,
          machine learning and building software applications.
        </p>

        <p class="section-description">
          I enjoy learning through hands-on projects, experimenting
          with different technologies and solving practical technical
          problems.
        </p>
      </section>

      <!-- Projects Section -->
      <section id="projects">
        <p class="eyebrow">02 / SELECTED WORK</p>

        <h2>Projects</h2>

        <p class="section-description">
          A selection of my academic and personal projects.
        </p>

        <div class="project-grid">
          {projects.map((project, index) => (
            <article class="project-card">
              <div class="project-top">
                <span class="project-number">
                  PROJECT_0{index + 1}
                </span>

                <span class="project-status">
                  {project.status}
                </span>
              </div>

              <p class="category">{project.category}</p>

              <h3>{project.name}</h3>

              <p class="project-description">
                {project.description}
              </p>

              <div class="tags">
                {project.technologies.map((tech) => (
                  <span>{tech}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Skills Section -->
      <section id="skills">
        <p class="eyebrow">03 / TECHNOLOGIES</p>

        <h2>Skills & Tools</h2>

        <p class="section-description">
          Technologies and tools I have worked with through
          academic projects and practical experience.
        </p>

        <div class="skills">
          {skills.map((skill) => (
            <span>{skill}</span>
          ))}
        </div>
      </section>

      <!-- Contact Section -->
      <section id="contact">
        <p class="eyebrow">04 / CONTACT</p>

        <h2>Let's Connect.</h2>

        <p class="section-description">
          Feel free to reach out for professional opportunities,
          collaborations or technical discussions.
        </p>

        <div class="actions">
          <a
            class="primary-button"
            href="https://github.com/zafrilll"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>

          <a
            class="secondary-button"
            href="mailto:YOUR_EMAIL@example.com"
          >
            Email Me
          </a>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer>
      <p>© 2026 Zafril Ihsan. Built with Astro.</p>

      <a href="#">Back to Top ↑</a>
    </footer>
  </body>
</html>

<style>
  /* =========================
     GLOBAL STYLES
  ========================= */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 30px;
  }

  :global(body) {
    margin: 0;
    background: #17191f;
    color: #f4f7ff;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.7;
  }

  :global(a) {
    text-decoration: none;
    color: inherit;
    transition: 0.2s ease;
  }

  /* =========================
     NAVIGATION
  ========================= */

  header {
    background: rgba(23, 25, 31, 0.95);
    border-bottom: 1px solid #343b49;
  }

  nav {
    max-width: 1050px;
    margin: auto;
    padding: 22px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -1px;
    color: #f4f7ff;
  }

  .logo span {
    color: #249bff;
  }

  .nav-links {
    display: flex;
    gap: 25px;
    font-size: 14px;
    color: #a8b0c0;
  }

  .nav-links a:hover {
    color: #55b8ff;
  }

  /* =========================
     MAIN LAYOUT
  ========================= */

  main {
    max-width: 900px;
    margin: auto;
    padding: 0 24px;
  }

  section {
    padding: 85px 0;
    border-bottom: 1px solid #343b49;
  }

  /* =========================
     HERO SECTION
  ========================= */

  .hero {
    padding-top: 120px;
    padding-bottom: 100px;
  }

  .eyebrow {
    color: #55b8ff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  h1 {
    font-size: clamp(38px, 7vw, 62px);
    line-height: 1.15;
    letter-spacing: -2px;
    margin: 20px 0 10px;
  }

  h1 span {
    color: #249bff;
    text-shadow: 0 0 18px rgba(36, 155, 255, 0.35);
  }

  h2 {
    font-size: 28px;
    letter-spacing: -0.7px;
    color: #f4f7ff;
  }

  .hero h2 {
    font-size: 22px;
    font-weight: 500;
    color: #a8b0c0;
  }

  .intro {
    max-width: 620px;
    color: #a8b0c0;
  }

  .hero-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 65px;
    color: #66748a;
    font-size: 10px;
    letter-spacing: 1.2px;
  }

  /* =========================
     BUTTONS
  ========================= */

  .actions {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  .primary-button,
  .secondary-button {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
  }

  .primary-button {
    background: #249bff;
    color: #101820;
  }

  .primary-button:hover {
    background: #55b8ff;
    color: #101820;
    box-shadow: 0 0 18px rgba(36, 155, 255, 0.35);
  }

  .secondary-button {
    border: 1px solid #55b8ff;
    color: #55b8ff;
  }

  .secondary-button:hover {
    background: rgba(36, 155, 255, 0.1);
  }

  /* =========================
     ABOUT SECTION
  ========================= */

  .section-description {
    max-width: 700px;
    color: #a8b0c0;
    font-size: 15px;
  }

  /* =========================
     PROJECT SECTION
  ========================= */

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-top: 30px;
  }

  .project-card {
    background: #252a35;
    border: 1px solid #343b49;
    border-radius: 9px;
    padding: 24px;
    transition: 0.25s ease;
  }

  .project-card:hover {
    border-color: #249bff;
    transform: translateY(-4px);
    box-shadow: 0 5px 25px rgba(36, 155, 255, 0.1);
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .project-number {
    color: #66748a;
    font-size: 10px;
    letter-spacing: 1px;
  }

  .project-status {
    color: #55b8ff;
    font-size: 10px;
  }

  .category {
    margin-top: 25px;
    font-size: 11px;
    color: #55b8ff;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .project-card h3 {
    font-size: 19px;
    line-height: 1.4;
    color: #f4f7ff;
  }

  .project-description {
    font-size: 14px;
    color: #a8b0c0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .tags span,
  .skills span {
    background: #17191f;
    color: #55b8ff;
    border: 1px solid #343b49;
    padding: 5px 10px;
    border-radius: 5px;
    font-size: 12px;
  }

  /* =========================
     SKILLS SECTION
  ========================= */

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 25px;
  }

  .skills span {
    padding: 8px 14px;
  }

  /* =========================
     FOOTER
  ========================= */

  footer {
    max-width: 900px;
    margin: auto;
    padding: 25px 24px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 13px;
    color: #a8b0c0;
  }

  footer a:hover {
    color: #55b8ff;
  }

  /* =========================
     MOBILE RESPONSIVE
  ========================= */

  @media (max-width: 600px) {
    nav {
      align-items: flex-start;
      gap: 15px;
      flex-direction: column;
    }

    .nav-links {
      gap: 15px;
      flex-wrap: wrap;
    }

    .hero {
      padding-top: 75px;
    }

    .hero-bottom {
      gap: 12px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    section {
      padding: 65px 0;
    }

    footer {
      flex-direction: column;
    }
  }
</style>
